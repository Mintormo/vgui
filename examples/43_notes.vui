// Пример 43: окно заметок в разметке .vui (см. 43_ui_markup.v / .py).
// Одна строка - один элемент, вложенность - отступом; #id - имя для кода.
vbox
  menubar
    menu "File"
      item "New note" icon=file-plus shortcut=Ctrl+N #new
      item "Save" icon=save shortcut=Ctrl+S #save_menu
      separator
      item "Quit" icon=log-out #quit
    menu "View"
      check "Word wrap" checked #wrap
  vbox pad=12 gap=8 flex=1
    hbox gap=8 cross=center
      input hint="Search notes" #search flex=1
      button "Save" icon=save style=accent #save
      toggle "Dark theme" #dark
    split ratio=0.3 flex=1
      list #notes
        item "Shopping" icon=shopping-cart
        item "Photo ideas" icon=camera
        item "Synth: chords" icon=music
      tabs
        tab "Text" icon=file-text
          textarea #text hint="Note text"
        tab "Preview" icon=eye
          markdown "# Note\n\nSelect a note on the left." #preview
    hbox gap=8 cross=center
      label "Ready" #status flex=1
      badge "3 notes" variant=neutral #count
